<%- include('partials/header',{title}) %>
<section class="hero-carousel" data-carousel><% if(banners.length){banners.forEach((b,i)=>{ %><article class="hero-slide <%= i===0?'active':'' %>" data-slide style="--slide-index:<%= i %>"><img src="<%= b.image_url %>" alt="<%= b.title %>" <%= i===0?'fetchpriority="high"':'loading="lazy"' %>><div class="hero-copy"><p class="eyebrow">THE NEW SUN EDITION · 2026</p><h1><%= b.title %></h1><p><%= b.subtitle %></p><a class="button button-dark" href="<%= b.cta_url %>"><%= b.cta_label %> ↗</a></div></article><% })}else{%><article class="hero-slide active"><img src="/images/banners/banner-1.svg" alt="Sunglasses collection"><div class="hero-copy"><p class="eyebrow">THE NEW SUN EDITION</p><h1>Own the<br>sunshine.</h1><p>Find your frame. Make your moment.</p><a class="button button-dark" href="/shop">Shop collection ↗</a></div></article><%}%><div class="carousel-controls"><button type="button" data-prev aria-label="Previous banner">←</button><div class="carousel-dots"><% banners.forEach((b,i)=>{ %><button type="button" data-dot="<%= i %>" class="<%= i===0?'active':'' %>" aria-label="Banner <%= i+1 %>"></button><% }) %></div><button type="button" data-next aria-label="Next banner">→</button></div></section>
<section class="ticker"><div>MADE FOR YOUR MOMENT <span>✳</span> FIND YOUR FRAME <span>✳</span> OWN THE SUN <span>✳</span> MADE FOR YOUR MOMENT <span>✳</span></div></section>
<section class="section-pad"><div class="section-heading"><div><p class="eyebrow">YOUR NEXT EVERYDAY ICON</p><h2>Frames with<br><em>main-character energy.</em></h2></div><a class="text-link" href="/shop">Shop all frames ↗</a></div><div class="product-grid"><% products.forEach((p,i)=>{ %><article class="product-card"><a class="product-image" href="/product/<%= p.slug %>"><% if(p.compare_at_paisa && Number(p.compare_at_paisa)>Number(p.price_paisa)){%><span class="product-tag">ON SALE</span><%}%><img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy"><span class="quick-view">View product ↗</span></a><div class="product-info"><div><a href="/product/<%= p.slug %>" class="product-name"><%= p.name %></a><p class="product-category"><%= p.category_name||'SUNPOP ORIGINALS' %></p></div><div class="price"><strong><%= money(p.price_paisa) %></strong><% if(p.compare_at_paisa && Number(p.compare_at_paisa)>Number(p.price_paisa)){%><del><%= money(p.compare_at_paisa) %></del><%}%></div></div></article><% }) %></div><div class="center-action"><a href="/shop" class="button button-outline">Explore all sunglasses ↗</a></div></section>
<section class="manifesto"><div class="manifesto-number">01 / THE SUN RULES</div><div><p class="eyebrow">NOT JUST AN ACCESSORY</p><h2>Look good.<br><em>Feel unstoppable.</em></h2><p>From slow mornings to late afternoons, your next favourite pair is waiting.</p><a href="/shop" class="button button-light">Find your frame ↗</a></div><div class="manifesto-shape">SUN<br>POP<span>✳</span></div></section>
<section class="benefit-row"><div><span>✳</span><strong>Easy ordering</strong><small>A few taps to your new favourite</small></div><div><span>↗</span><strong>Bangladesh delivery</strong><small>Delivery details at checkout</small></div><div><span>◉</span><strong>Secure checkout</strong><small>COD and online payment option</small></div></section>
<%- include('partials/footer') %>
