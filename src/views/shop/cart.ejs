<%- include('../partials/header',{title}) %><section class="page-hero compact-hero"><p class="eyebrow">YOUR SELECTION</p><h1>Your <em>cart.</em></h1></section><section class="section-pad cart-layout"><% const lines=Object.values(cart||{}); if(!lines.length){%><div class="empty-state"><h2>Your cart is taking a little break.</h2><p>Find a frame that feels like you.</p><a href="/shop" class="button button-dark">Explore sunglasses ↗</a></div><%}else{%><form method="post" action="/cart/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="cart-lines"><% lines.forEach(line=>{%><article class="cart-line"><img src="<%= line.image_url %>" alt="<%= line.name %>"><div class="cart-line-info"><a href="/product/<%= line.slug %>"><strong><%= line.name %></strong></a><small><%= money(line.price_paisa) %> each</small><label>Qty <input type="number" name="quantity[<%= line.product_id %>]" min="0" max="20" value="<%= line.quantity %>"></label></div><strong><%= money(line.price_paisa*line.quantity) %></strong></article><%})%></div><button class="button button-outline" type="submit">Update cart</button></form><aside class="cart-summary"><p class="eyebrow">ORDER SUMMARY</p><h2>Ready when you are.</h2><div class="summary-line"><span>Subtotal</span><strong><%= money(lines.reduce((n,p)=>n+p.price_paisa*p.quantity,0)) %></strong></div><p class="muted">Delivery charges are calculated at checkout.</p><a href="/checkout" class="button button-dark full-width">Continue to checkout ↗</a><a href="/shop" class="text-link">← Keep shopping</a></aside><%}%></section><%- include('../partials/footer') %>
