<%- include('../partials/header',{title}) %><section class="section-pad product-detail"><div class="detail-image"><img id="main-product-image" src="<%= product.image_url %>" alt="<%= product.name %>"><span class="product-tag"><%= product.is_featured?'STAFF PICK':'SUNPOP ORIGINALS' %></span><button type="button" class="viewer3d-btn" data-viewer3d data-style="<%= product.category_name||'' %>" data-seed="<%= product.id %>">3D ভিউ ↻</button><% const gal=(product.gallery||[]); if(gal.length){%><div class="gallery-thumbs"><% [product.image_url,...gal].forEach((g,n)=>{%><button type="button" data-gallery="<%= g %>" aria-label="ছবি <%= n+1 %>"><img src="<%= g %>" alt="" loading="lazy"></button><%})%></div><%}%></div><div class="detail-copy"><p class="eyebrow"><%= product.category_name||'SUNPOP ORIGINALS' %> / <%= product.sku %></p><h1><%= product.name %></h1><div class="detail-price"><strong><%= money(product.price_paisa) %></strong><% if(product.compare_at_paisa && Number(product.compare_at_paisa)>Number(product.price_paisa)){%><del><%= money(product.compare_at_paisa) %></del><span class="sale-label">SALE</span><%}%></div><p class="detail-description"><%= product.description %></p><p class="stock-note <%= product.stock>0?'in-stock':'out-stock' %>"><span></span><%= product.stock>5?'In stock':(product.stock>0?`Only ${product.stock} left`:'Out of stock') %></p><% if(product.stock>0){%><form method="post" action="/cart/add" class="add-cart-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= product.id %>"><label>Quantity <input type="number" name="quantity" min="1" max="<%= Math.min(product.stock,20) %>" value="1"></label><button class="button button-dark" type="submit">Add to cart ↗</button></form><%}else{%><button class="button button-disabled" disabled>Currently unavailable</button><%}%><div class="detail-perks"><p>✳ Designed for everyday wear</p><p>↗ <a href="/page/delivery">সারা বাংলাদেশে ডেলিভারি</a></p><p>◉ ক্যাশ অন ডেলিভারি</p><p>↺ <a href="/page/returns">৩ দিনের রিটার্ন নীতি</a></p></div></div></section><section class="section-pad"><div class="section-heading"><div><p class="eyebrow">MORE TO LOVE</p><h2>Keep exploring.</h2></div><a href="/shop" class="text-link">All frames ↗</a></div><div class="product-grid"><% related.forEach(p=>{%><article class="product-card"><a class="product-image" href="/product/<%= p.slug %>"><img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy"></a><div class="product-info"><a href="/product/<%= p.slug %>" class="product-name"><%= p.name %></a><strong><%= money(p.price_paisa) %></strong></div></article><%})%></div></section><%- include('../partials/footer') %>
