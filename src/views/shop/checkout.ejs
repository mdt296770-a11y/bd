<%- include('../partials/header',{title}) %><section class="page-hero compact-hero"><p class="eyebrow">ALMOST YOURS</p><h1>Checkout <em>time.</em></h1></section><section class="section-pad checkout-layout"><form method="post" action="/checkout" class="checkout-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="checkout_key" value="<%= locals.checkoutKey||'' %>"><% if(locals.error){%><div class="form-error"><%= error %></div><%}%><h2>Delivery details</h2><div class="form-grid"><label>Full name<input name="full_name" required maxlength="120" autocomplete="name"></label><label>Bangladesh mobile number<input name="phone" required pattern="01[3-9][0-9]{8}" placeholder="01XXXXXXXXX" autocomplete="tel"></label><label>Email (optional)<input type="email" name="email" autocomplete="email"></label><label>District<input name="district" required maxlength="80" placeholder="e.g. Dhaka" list="districts"></label><label>Area / Thana<input name="area" required maxlength="100" placeholder="e.g. Dhanmondi"></label><label class="wide-field">Full address<textarea name="address" required maxlength="500" rows="3" placeholder="House, road, landmark..."></textarea></label></div><datalist id="districts"><% districts.forEach(d=>{%><option value="<%= d %>"><%})%></datalist><h2>Payment method</h2><label class="payment-choice"><input type="radio" name="payment_method" value="cod" checked><span><strong>Cash on Delivery</strong><small>Pay when your order arrives.</small></span></label><% if(onlinePaymentConfigured){%><label class="payment-choice"><input type="radio" name="payment_method" value="online"><span><strong>Online payment</strong><small>Secure payment via configured SSLCommerz gateway.</small></span></label><%}else{%><p class="muted">অনলাইন পেমেন্ট বর্তমানে সেটআপ করা নেই। আপাতত Cash on Delivery ব্যবহার করুন।</p><%}%><button class="button button-dark full-width" type="submit">Place order ↗</button><p class="muted">Your details are used to process this order. <a href="/page/privacy">গোপনীয়তা নীতি</a> ও <a href="/page/returns">রিটার্ন নীতি</a> দেখুন।</p></form><aside class="cart-summary"><p class="eyebrow">YOUR ORDER</p><% Object.values(cart||{}).forEach(line=>{%><div class="summary-line"><span><%= line.name %> × <%= line.quantity %></span><strong><%= money(line.price_paisa*line.quantity) %></strong></div><%})%><div class="summary-line"><span>Delivery</span><span>Calculated from district</span></div><p class="muted">ডেলিভারি চার্জ: ঢাকায় <%= money(deliveryDhaka*100) %>, ঢাকার বাইরে <%= money(deliveryOutside*100) %>। মোট টাকা অর্ডার নিশ্চিত হওয়ার পর পেজে দেখানো হবে।</p></aside></section><%- include('../partials/footer') %>
