<%- include('../partials/header',{title}) %><section class="page-hero compact-hero"><p class="eyebrow">FIND YOUR FRAME</p><h1>Shop all<br><em>sunglasses.</em></h1><p>Bold shapes. Everyday confidence.</p></section><section class="section-pad shop-section"><form class="filter-bar" method="get" action="/shop"><label class="search-field"><span aria-hidden="true">⌕</span><input type="search" aria-label="সার্চ" name="q" value="<%= filters.q %>" placeholder="Search frames or SKU..."></label><select name="category" aria-label="ক্যাটাগরি"><option value="">All styles</option><% categories.forEach(c=>{%><option value="<%= c.slug %>" <%= filters.category===c.slug?'selected':'' %>><%= c.name %></option><%})%></select><select name="sort" aria-label="সাজান"><option value="featured" <%= filters.sort==='featured'?'selected':'' %>>Featured</option><option value="newest" <%= filters.sort==='newest'?'selected':'' %>>Newest</option><option value="price-asc" <%= filters.sort==='price-asc'?'selected':'' %>>Price: low to high</option><option value="price-desc" <%= filters.sort==='price-desc'?'selected':'' %>>Price: high to low</option></select><button class="button button-dark" type="submit">Filter ↗</button></form><div class="result-count"><%= total %> frames to explore</div><div class="product-grid"><% products.forEach(p=>{%><article class="product-card"><a class="product-image" href="/product/<%= p.slug %>"><% if(p.stock===0){%><span class="product-tag sold-tag">SOLD OUT</span><%}%><img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy"><span class="quick-view">View product ↗</span></a><div class="product-info"><div><a href="/product/<%= p.slug %>" class="product-name"><%= p.name %></a><p class="product-category"><%= p.category_name||'SUNPOP ORIGINALS' %></p></div><div class="price"><strong><%= money(p.price_paisa) %></strong></div></div></article><%})%></div><% if(pages>1){const qs=p=>{const u=new URLSearchParams();if(filters.q)u.set("q",filters.q);if(filters.category)u.set("category",filters.category);if(filters.sort!=="featured")u.set("sort",filters.sort);if(p>1)u.set("page",p);const s=u.toString();return "/shop"+(s?"?"+s:"")};%><nav class="pagination" aria-label="পেজ নেভিগেশন"><% if(page>1){%><a class="button button-outline button-small" href="<%= qs(page-1) %>" rel="prev">← আগের</a><%}%><span>পেজ <%= page %> / <%= pages %></span><% if(page<pages){%><a class="button button-outline button-small" href="<%= qs(page+1) %>" rel="next">পরের →</a><%}%></nav><%}%><% if(!products.length){%><div class="empty-state"><h2>No frames found.</h2><p>Try another search or category.</p><a class="button button-dark" href="/shop">Clear filters</a></div><%}%></section><%- include('../partials/footer') %>
