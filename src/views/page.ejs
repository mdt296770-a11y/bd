<%- include('partials/header',{title}) %><section class="page-hero compact-hero"><p class="eyebrow">SUNPOP</p><h1><%= page.title %></h1></section><section class="section-pad prose"><% page.body.forEach(([h,t])=>{%><h2><%= h %></h2><p><%= t %></p><%})%><% if(slug==='contact'){%><h2>আমাদের সঙ্গে কথা বলুন</h2><ul class="contact-list"><% if(site.phone){%><li>ফোন: <a href="tel:<%= site.phone %>"><%= site.phone %></a></li><%}%><% if(site.whatsapp){%><li>WhatsApp: <a href="https://wa.me/<%= site.whatsapp.replace(/\D/g,'') %>" rel="noopener">মেসেজ করুন</a></li><%}%><% if(site.email){%><li>ইমেইল: <a href="mailto:<%= site.email %>"><%= site.email %></a></li><%}%><% if(site.address){%><li>ঠিকানা: <%= site.address %></li><%}%><% if(!site.phone&&!site.email&&!site.address){%><li>যোগাযোগের তথ্য এখনো যোগ করা হয়নি।</li><%}%></ul><p class="muted">অর্ডারের স্ট্যাটাস জানতে আপনার অর্ডার নম্বর ও মোবাইল নম্বর ব্যবহার করে অর্ডার ট্র্যাক করুন।</p><%}%></section><%- include('partials/footer') %>
