<%- include('layout-top',{title}) %><p class="eyebrow">CATALOGUE / EDITOR</p><h1><%= product&&product.id?'Edit':'Add a new' %><br><em>frame.</em></h1><% if(error){%><div class="form-error"><%= error %></div><%}%><form method="post" enctype="multipart/form-data" action="<%= product&&product.id?'/admin/products/'+product.id:'/admin/products' %>" class="admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>Product name<input name="name" required value="<%= product?.name||'' %>"></label><label>SKU<input name="sku" required value="<%= product?.sku||'' %>"></label><label>Price (BDT)<input type="number" min="0" step="0.01" name="price" required value="<%= product?(Number(product.price_paisa)/100).toFixed(2):'' %>"></label><label>Compare-at price (BDT)<input type="number" min="0" step="0.01" name="compare_at_price" value="<%= product?.compare_at_paisa?(Number(product.compare_at_paisa)/100).toFixed(2):'' %>"></label><label>Category<select name="category_id"><option value="">No category</option><% categories.forEach(c=>{%><option value="<%= c.id %>" <%= Number(product?.category_id)===c.id?'selected':'' %>><%= c.name %></option><%})%></select></label><label>Stock quantity<input type="number" min="0" step="1" name="stock" required value="<%= product?.stock??0 %>"></label><label class="wide-field">Upload product image (PNG/JPEG/WebP/GIF, max 5 MB)<input type="file" name="image_file" accept="image/png,image/jpeg,image/webp,image/gif"></label><label class="wide-field">Or image URL (site path or https:// link)<input name="image_url" value="<%= product?.image_url||'/images/products/placeholder.svg' %>"></label><label class="wide-field">Add gallery images (up to 5; PNG/JPEG/WebP/GIF, max 5 MB each)<input type="file" name="gallery_files" multiple accept="image/png,image/jpeg,image/webp,image/gif"></label><% if(product&&(product.gallery||[]).length){%><fieldset class="wide-field gallery-edit"><legend>Gallery images — tick to remove</legend><% product.gallery.forEach(g=>{%><label class="check-field"><img src="<%= g %>" alt="" width="64" height="64"><input type="checkbox" name="remove_gallery" value="<%= g %>"> Remove</label><%})%></fieldset><%}%><label class="wide-field">Description<textarea name="description" rows="4"><%= product?.description||'' %></textarea></label><label class="check-field"><input type="checkbox" name="is_active" <%= !product||product.is_active?'checked':'' %>> Active on storefront</label><label class="check-field"><input type="checkbox" name="is_featured" <%= product?.is_featured?'checked':'' %>> Featured product</label></div><div class="form-actions"><a class="button button-outline" href="/admin/products">Cancel</a><button class="button button-dark" type="submit">Save product ↗</button></div></form><%- include('layout-bottom') %>
