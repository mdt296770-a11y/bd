<%- include('layout-top',{title}) %><p class="eyebrow"><a href="/admin/orders">← ORDERS</a></p><h1><%= order.order_number %></h1><% if(error){%><div class="form-error"><%= error %></div><%}%>
<div class="dash-cols"><section class="detail-card"><h2 class="admin-h2">Customer &amp; delivery</h2><p><strong><%= order.customer_name %></strong><br><a href="tel:<%= order.phone %>"><%= order.phone %></a><% if(order.email){%><br><%= order.email %><%}%></p><p><%= order.address %><br><%= order.area %>, <%= order.district %></p><p class="muted">Placed <%= new Date(order.created_at).toLocaleString('en-BD') %></p></section>
<section class="detail-card"><h2 class="admin-h2">Payment</h2><p><span class="status-pill"><%= order.payment_method %> / <%= order.payment_status %></span></p><div class="summary-line"><span>Subtotal</span><strong><%= money(order.subtotal_paisa) %></strong></div><div class="summary-line"><span>Delivery</span><strong><%= money(order.delivery_paisa) %></strong></div><div class="summary-line"><span>Total</span><strong><%= money(order.total_paisa) %></strong></div><% if(order.gateway_reference){%><p class="muted">Gateway ref: <%= order.gateway_reference %></p><%}%><% events.forEach(e=>{%><p class="muted"><%= e.event_type %> · <%= new Date(e.processed_at).toLocaleString('en-BD') %></p><%})%>
<% if(admin.role==='admin'){%><form method="post" action="/admin/orders/<%= order.id %>/payment" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="payment_status" aria-label="Payment status"><% PAYMENT_STATUSES.forEach(s=>{%><option <%= order.payment_status===s?'selected':'' %>><%= s %></option><%})%></select><button class="button button-small button-outline">Update payment</button></form><%}%></section></div>
<h2 class="admin-h2">Items</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Unit</th><th>Qty</th><th>Total</th></tr></thead><tbody><% items.forEach(i=>{%><tr><td><div class="table-product"><img src="<%= i.image_url %>" alt=""><strong><%= i.product_name %></strong></div></td><td><%= i.sku %></td><td><%= money(i.unit_price_paisa) %></td><td><%= i.quantity %></td><td><%= money(i.line_total_paisa) %></td></tr><%})%></tbody></table></div>
<h2 class="admin-h2">Fulfilment status</h2><p>Current: <span class="status-pill <%= order.order_status==='delivered'?'good':'' %>"><%= order.order_status %></span></p><form method="post" action="/admin/orders/<%= order.id %>/status" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="order_status" aria-label="New status"><% STATUSES.forEach(s=>{%><option value="<%= s %>" <%= order.order_status===s?'selected':'' %>><%= s %></option><%})%></select><label class="check-field"><input type="checkbox" name="restock"> If returned: put items back in stock</label><button class="button button-dark">Update status</button></form><p class="muted">Cancelling returns stock automatically. COD orders become “paid” when marked delivered.</p><%- include('layout-bottom') %>
