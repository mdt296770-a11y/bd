<%- include('layout-top',{title}) %><p class="eyebrow">INSIGHTS / DELIVERED ORDERS</p><h1>Sales <em>report.</em></h1>
<form method="get" class="filter-bar"><label>From <input type="date" name="from" value="<%= from %>"></label><label>To <input type="date" name="to" value="<%= to %>"></label><button class="button button-dark">Apply</button></form>
<div class="stats-grid"><div class="stat-card"><small>Gross delivered sales</small><strong><%= money(summary.gross) %></strong><span>Before refunds &amp; costs</span></div><div class="stat-card"><small>Delivered orders</small><strong><%= summary.delivered %></strong><span>of <%= summary.placed %> placed</span></div><div class="stat-card"><small>Cancelled / returned</small><strong><%= summary.lost %></strong><span>In this period</span></div><div class="stat-card"><small>Avg. order value</small><strong><%= money(summary.delivered?Math.round(Number(summary.gross)/summary.delivered):0) %></strong><span>Delivered</span></div></div>
<div class="dash-cols"><section><h2 class="admin-h2">Best sellers</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Units</th><th>Revenue</th></tr></thead><tbody><% top.forEach(t=>{%><tr><td><strong><%= t.product_name %></strong><small><%= t.sku %></small></td><td><%= t.qty %></td><td><%= money(t.revenue) %></td></tr><%})%></tbody></table><% if(!top.length){%><p class="empty-state">No data.</p><%}%></div></section><section><h2 class="admin-h2">Orders by status</h2><div class="table-wrap"><table><tbody><% status.forEach(s=>{%><tr><td><%= s.s %></td><td><%= s.n %></td></tr><%})%></tbody></table></div></section></div>
<h2 class="admin-h2">Daily delivered sales</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Delivered orders</th><th>Gross sales</th></tr></thead><tbody><% rows.forEach(r=>{%><tr><td><%= new Date(r.day).toLocaleDateString('en-BD') %></td><td><%= r.orders %></td><td><strong><%= money(r.gross) %></strong></td></tr><%})%></tbody></table><% if(!rows.length){%><p class="empty-state">No delivered orders in this range.</p><%}%></div><%- include('layout-bottom') %>
