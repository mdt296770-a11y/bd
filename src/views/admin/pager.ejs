<% if(pages>1){ const q=Object.assign({},query||{}); const href=p=>{const u=new URLSearchParams();Object.entries(q).forEach(([k,v])=>{if(v)u.set(k,v)});if(p>1)u.set('page',p);const s=u.toString();return base+(s?'?'+s:'')}; %><nav class="pagination" aria-label="Pages"><% if(page>1){%><a class="button button-small button-outline" href="<%= href(page-1) %>">← Prev</a><%}%><span>Page <%= page %> / <%= pages %></span><% if(page<pages){%><a class="button button-small button-outline" href="<%= href(page+1) %>">Next →</a><%}%></nav><%}%>
