<%- include('layout-top',{title}) %><p class="eyebrow">SECURITY</p><h1>Activity <em>log.</em></h1><div class="table-wrap"><table><thead><tr><th>When</th><th>Who</th><th>Action</th><th>Item</th><th>Details</th></tr></thead><tbody><% logs.forEach(l=>{%><tr><td><%= new Date(l.created_at).toLocaleString('en-BD') %></td><td><%= l.email||'—' %><small><%= l.ip_address %></small></td><td><%= l.action %></td><td><%= l.entity_type %> <%= l.entity_id %></td><td><small><%= JSON.stringify(l.details||{}) %></small></td></tr><%})%></tbody></table></div><%- include('pager',{page,pages,base:'/admin/audit',query:{}}) %><%- include('layout-bottom') %>
