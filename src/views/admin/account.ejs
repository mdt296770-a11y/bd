<%- include('layout-top',{title}) %><p class="eyebrow">ACCOUNT</p><h1>My <em>account.</em></h1><p class="muted"><%= admin.name %> · <%= admin.email %> · <%= admin.role %></p><% if(ok){%><div class="form-ok">Password updated.</div><%}%><% if(error){%><div class="form-error"><%= error %></div><%}%>
<form method="post" action="/admin/account/password" class="admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>Current password<input type="password" name="current" required autocomplete="current-password"></label><span></span><label>New password (min 10 chars, letters + numbers)<input type="password" name="next" required minlength="10" autocomplete="new-password"></label><label>Confirm new password<input type="password" name="confirm" required minlength="10" autocomplete="new-password"></label></div><button class="button button-dark">Change password</button></form><%- include('layout-bottom') %>
