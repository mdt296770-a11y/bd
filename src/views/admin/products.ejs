<%- include('layout-top',{title}) %><div class="admin-title-row"><div><p class="eyebrow">CATALOGUE</p><h1>Your <em>products.</em></h1><p class="muted"><%= total %> products</p></div><a class="button button-dark" href="/admin/products/new">+ Add product</a></div>
<form method="get" class="filter-bar"><label class="search-field"><span aria-hidden="true">⌕</span><input type="search" name="q" value="<%= q %>" placeholder="Search name or SKU" aria-label="Search"></label><select name="filter" aria-label="Filter"><option value="">All</option><option value="low" <%= filter==='low'?'selected':'' %>>Low stock</option><option value="hidden" <%= filter==='hidden'?'selected':'' %>>Hidden</option></select><button class="button button-dark">Filter</button></form>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU</th><th>Price</th><th>Stock</th><th>Status</th><th>Actions</th></tr></thead><tbody><% products.forEach(p=>{%><tr><td><div class="table-product"><img src="<%= p.image_url %>" alt=""><span><strong><%= p.name %></strong><small><%= p.category_name||'Uncategorised' %></small></span></div></td><td><%= p.sku %></td><td><%= money(p.price_paisa) %></td><td><form method="post" action="/admin/products/<%= p.id %>/stock" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="number" name="stock" min="0" value="<%= p.stock %>" aria-label="Stock for <%= p.name %>" class="stock-input <%= p.stock<5?'warning':'' %>"><button class="button button-small button-outline">Set</button></form></td><td><span class="status-pill <%= p.is_active?'good':'' %>"><%= p.is_active?'Active':'Hidden' %></span></td><td><div class="table-actions"><a href="/admin/products/<%= p.id %>/edit">Edit</a><form method="post" action="/admin/products/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= p.is_active?'Hide':'Show' %></button></form></div></td></tr><%})%></tbody></table><% if(!products.length){%><p class="empty-state">No products found.</p><%}%></div><%- include('pager',{page,pages,base:'/admin/products',query:{q,filter}}) %><%- include('layout-bottom') %>
