<%- include('layout-top',{title}) %><p class="eyebrow">STORE CONTROL / OVERVIEW</p><div class="admin-title-row"><div><h1>Welcome back,<br><em><%= admin.name %>.</em></h1><p class="muted">Your store at a glance.</p></div><a href="/admin/products/new" class="button button-dark">+ Add product</a></div>
<div class="stats-grid"><div class="stat-card"><small>Total orders</small><strong><%= stats.orders %></strong><span>All time</span></div><div class="stat-card"><small>Active products</small><strong><%= stats.products %></strong><span>On storefront</span></div><div class="stat-card"><small>Low stock</small><strong><%= stats.low %></strong><span>Below 5 units</span></div><div class="stat-card"><small>Delivered sales</small><strong><%= money(stats.sales) %></strong><span>Delivered orders</span></div></div>
<div class="dash-cols"><section><h2 class="admin-h2">Recent orders</h2><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th></tr></thead><tbody><% recent.forEach(o=>{%><tr><td><a href="/admin/orders/<%= o.id %>"><strong><%= o.order_number %></strong></a></td><td><%= o.customer_name %></td><td><%= money(o.total_paisa) %></td><td><span class="status-pill"><%= o.order_status %></span></td></tr><%})%></tbody></table><% if(!recent.length){%><p class="empty-state">No orders yet.</p><%}%></div></section>
<section><h2 class="admin-h2">Low stock</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Stock</th><th></th></tr></thead><tbody><% lowStock.forEach(p=>{%><tr><td><strong><%= p.name %></strong><small><%= p.sku %></small></td><td><span class="stock-pill warning"><%= p.stock %></span></td><td><a href="/admin/products/<%= p.id %>/edit">Restock</a></td></tr><%})%></tbody></table><% if(!lowStock.length){%><p class="empty-state">All products are well stocked.</p><%}%></div></section></div>
<div class="admin-shortcuts"><a href="/admin/products"><span>01</span><strong>Manage products</strong><small>Images, prices, stock ↗</small></a><a href="/admin/orders"><span>02</span><strong>Order desk</strong><small>Search, fulfil, export ↗</small></a><% if(admin.role==='admin'){%><a href="/admin/banners"><span>03</span><strong>Homepage banners</strong><small>Refresh campaigns ↗</small></a><a href="/admin/reports"><span>04</span><strong>Sales reports</strong><small>Revenue &amp; best sellers ↗</small></a><%}%></div><%- include('layout-bottom') %>
