<%- include('layout-top',{title}) %><p class="eyebrow">CATALOGUE / STRUCTURE</p><h1>Product <em>categories.</em></h1><% if(error){%><div class="form-error"><%= error %></div><%}%>
<form method="post" action="/admin/categories" class="status-form add-row"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" required maxlength="60" placeholder="New category name" aria-label="New category name"><button class="button button-dark">+ Add category</button></form>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Slug</th><th>Products</th><th>Actions</th></tr></thead><tbody><% categories.forEach(c=>{%><tr><td><form method="post" action="/admin/categories/<%= c.id %>" class="status-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" value="<%= c.name %>" required maxlength="60" aria-label="Category name"><button class="button button-small button-outline">Rename</button></form></td><td><%= c.slug %></td><td><%= c.n %></td><td><form method="post" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Delete this category? Products stay but become uncategorised.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-outline" type="submit">Delete</button></form></td></tr><%})%></tbody></table></div><%- include('layout-bottom') %>
