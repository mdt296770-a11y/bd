<%- include('layout-top',{title}) %><p class="eyebrow">TEAM</p><h1>Admin <em>users.</em></h1><p class="muted"><strong>admin</strong>: everything. <strong>manager</strong>: products and orders only.</p><% if(error){%><div class="form-error"><%= error %></div><%}%>
<form method="post" action="/admin/users" class="admin-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>Name<input name="name" required maxlength="80"></label><label>Email<input type="email" name="email" required></label><label>Password (min 10, letters + numbers)<input type="password" name="password" required minlength="10" autocomplete="new-password"></label><label>Role<select name="role"><option value="manager">manager</option><option value="admin">admin</option></select></label></div><button class="button button-dark">Add user</button></form>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead><tbody><% users.forEach(u=>{%><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><% if(u.id!==admin.id){%><form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Remove this user?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-small button-outline">Remove</button></form><%}%></td></tr><%})%></tbody></table></div><%- include('layout-bottom') %>
