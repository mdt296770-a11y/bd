<%- include('layout-top',{title}) %><p class="eyebrow">FULFILMENT / ORDER DESK</p><h1>All <em>orders.</em></h1>
<form method="get" class="filter-bar"><label class="search-field"><span aria-hidden="true">⌕</span><input type="search" name="q" value="<%= q %>" placeholder="Order no, phone or name" aria-label="Search orders"></label><select name="status" aria-label="Order status"><option value="">All statuses</option><% STATUSES.forEach(s=>{%><option <%= status===s?'selected':'' %>><%= s %></option><%})%></select><select name="payment" aria-label="Payment status"><option value="">All payments</option><% PAYMENT_STATUSES.forEach(s=>{%><option <%= payment===s?'selected':'' %>><%= s %></option><%})%></select><button class="button button-dark">Filter</button><a class="button button-outline" href="/admin/orders.csv?<%= new URLSearchParams({q,status,payment}).toString() %>">Export CSV</a></form>
<p class="muted"><%= total %> orders</p><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr></thead><tbody><% orders.forEach(o=>{%><tr><td><a href="/admin/orders/<%= o.id %>"><strong><%= o.order_number %></strong></a><small><%= new Date(o.created_at).toLocaleString('en-BD') %></small></td><td><strong><%= o.customer_name %></strong><small><%= o.phone %> · <%= o.district %></small></td><td><%= money(o.total_paisa) %></td><td><span class="status-pill"><%= o.payment_method %> / <%= o.payment_status %></span></td><td><span class="status-pill <%= o.order_status==='delivered'?'good':'' %>"><%= o.order_status %></span></td><td><a class="button button-small button-dark" href="/admin/orders/<%= o.id %>">Open</a></td></tr><%})%></tbody></table><% if(!orders.length){%><p class="empty-state">No orders found.</p><%}%></div><%- include('pager',{page,pages,base:'/admin/orders',query:{q,status,payment}}) %><%- include('layout-bottom') %>
