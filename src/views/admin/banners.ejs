<%- include('layout-top',{title}) %><p class="eyebrow">HOME PAGE / CAMPAIGNS</p><h1>Make some <em>noise.</em></h1><p class="muted">Edit the six homepage slides. Use images sized for a wide hero (recommended 1920 × 900).</p><% if(error){%><div class="form-error"><%= error %></div><%}%><form method="post" enctype="multipart/form-data" action="/admin/banners" class="banner-edit-card new-banner"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><strong>+ Add a banner</strong><label>Headline<input name="title" required maxlength="120"></label><label>Subtitle<input name="subtitle" maxlength="200"></label><label>Upload image (PNG/JPEG/WebP/GIF, max 5 MB)<input type="file" name="image_file" accept="image/png,image/jpeg,image/webp,image/gif"></label><label>Or image URL<input name="image_url" placeholder="/images/banners/banner-1.svg"></label><div class="form-grid"><label>Button text<input name="cta_label" value="Shop Now"></label><label>Button URL<input name="cta_url" value="/shop"></label><label>Order<input type="number" name="sort_order" value="0"></label><label class="check-field"><input type="checkbox" name="is_active" checked> Active</label></div><button class="button button-dark full-width">Add banner</button></form><p class="muted">The homepage shows the first 6 active banners by order.</p><div class="banner-admin-grid"><% banners.forEach(b=>{%><form method="post" enctype="multipart/form-data" action="/admin/banners/<%= b.id %>" class="banner-edit-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><img src="<%= b.image_url %>" alt="<%= b.title %>"><label>Headline<input name="title" required value="<%= b.title %>"></label><label>Subtitle<input name="subtitle" value="<%= b.subtitle %>"></label><label>Image URL<input name="image_url" required value="<%= b.image_url %>"></label><label>Upload replacement image (PNG/JPEG/WebP/GIF, max 5 MB)<input type="file" name="image_file" accept="image/png,image/jpeg,image/webp,image/gif"></label><div class="form-grid"><label>Button text<input name="cta_label" value="<%= b.cta_label %>"></label><label>Button URL<input name="cta_url" value="<%= b.cta_url %>"></label><label>Order<input type="number" name="sort_order" value="<%= b.sort_order %>"></label><label class="check-field"><input type="checkbox" name="is_active" <%= b.is_active?'checked':'' %>> Active</label></div><button class="button button-dark full-width">Save banner</button><button class="button button-outline full-width" type="submit" formaction="/admin/banners/<%= b.id %>/delete" formenctype="application/x-www-form-urlencoded" onclick="return confirm('Delete this banner?')">Delete</button></form><%})%></div><%- include('layout-bottom') %>
