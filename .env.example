NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sunglasses_bd
# Set true if your managed PostgreSQL requires TLS
DATABASE_SSL=false
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Number of reverse proxies in front of the app (Nginx/Cloudflare=1). Leave empty when running directly.
TRUST_PROXY=

ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- Storefront ----
STORE_NAME=SUNPOP
STORE_CURRENCY=BDT
STORE_PHONE=
STORE_WHATSAPP=
STORE_EMAIL=
STORE_ADDRESS=
STORE_ANNOUNCEMENT=সারা বাংলাদেশে ক্যাশ অন ডেলিভারি · ঢাকায় দ্রুত ডেলিভারি
# Delivery charge in BDT (taka). Dhaka vs rest of Bangladesh.
DELIVERY_DHAKA_BDT=60
DELIVERY_OUTSIDE_BDT=120
# Unpaid online orders are cancelled and stock is released after this many minutes
PENDING_PAYMENT_MINUTES=30

# ---- Online payments (stay disabled until merchant credentials are approved) ----
PAYMENT_GATEWAY=disabled
APP_BASE_URL=http://localhost:3000
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
